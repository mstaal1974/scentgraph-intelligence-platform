AROMATWIN_ENVIRONMENT=development
AROMATWIN_DATABASE_URL=postgresql+psycopg://aromatwin:aromatwin@localhost:5432/aromatwin
# Authentication fails closed. Every surface below denies all callers until its key is set,
# and a non-local AROMATWIN_ENVIRONMENT refuses to start while any of them is blank.
# AROMATWIN_API_KEY gates the licensed retailer surface (/maison, /products, /scentprint-quiz).
AROMATWIN_API_KEY=
AROMATWIN_ADMIN_API_KEY=
AROMATWIN_PRIVATE_API_KEY=
# Local development only: serve the private surfaces without keys. Settings validation rejects
# this outside development/dev/local/test/testing, so it cannot be enabled in a deployment.
AROMATWIN_ALLOW_INSECURE_LOCAL_AUTH=false
AROMATWIN_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8000
AROMATWIN_ENABLE_ADMIN_CONSOLE=true
AROMATWIN_ENABLE_PRIVATE_SUPPLIER_ENDPOINTS=true
AROMATWIN_LOG_LEVEL=INFO
AROMATWIN_PUBLIC_API_PREFIX=
AROMATWIN_INTERNAL_API_PREFIX=
AROMATWIN_POSTGRES_DB=aromatwin
AROMATWIN_POSTGRES_USER=aromatwin
AROMATWIN_POSTGRES_PASSWORD=change-me
