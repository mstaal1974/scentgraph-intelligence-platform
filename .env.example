AROMATWIN_ENVIRONMENT=development
AROMATWIN_DATABASE_URL=postgresql+psycopg://aromatwin:aromatwin@localhost:5432/aromatwin
AROMATWIN_API_KEY=
AROMATWIN_ADMIN_API_KEY=
AROMATWIN_PRIVATE_API_KEY=
